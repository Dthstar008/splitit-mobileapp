# Copy to .env for local dev. NEVER commit the real .env — it is (and must
# stay) in .gitignore.
#
# Expo only inlines EXPO_PUBLIC_* variables into the client bundle at Metro
# startup, not live — restart `expo start` after changing this file.

# Your machine's LAN IP (not localhost — on a phone or emulator, localhost
# means the device itself). Find it with `ipconfig` (Windows) / `ifconfig`
# (Mac/Linux); must match the network your phone is actually on.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Optional — Sentry error tracking (see lib/sentry.ts). Leave blank to
# disable; no Sentry account needed for local dev.
EXPO_PUBLIC_SENTRY_DSN=
