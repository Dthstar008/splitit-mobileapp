# Copy to .env for local dev. NEVER commit the real .env — it is (and must
# stay) in .gitignore. In production these come from a secrets manager
# (Doppler / AWS Secrets Manager / CI-injected encrypted env), not a file.

PORT=4000
NODE_ENV=development

# Postgres connection string for Prisma. Local dev example:
# postgresql://postgres:postgres@localhost:5432/splitit?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitit?schema=public

# Required in every environment. src/config/env.ts refuses to start the
# server if this is missing — there is no hardcoded fallback.
JWT_SECRET=

# Paystack. Leave PAYSTACK_SECRET_KEY unset (or "sk_test_xxx...") to run
# payment.service.ts in mock mode for local dev. Both are required (and
# validated as looking like real Paystack keys) once NODE_ENV=production.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# 5.75%, not 1.5% — deliberately set just above the ~5.58% breakeven point
# (see payment.service.ts's estimatePaystackChargeFeeKobo) at which
# SplitIt's own cut is large enough to fully absorb Paystack's real
# processing fee on a charge (1.5% of the TOTAL amount + a flat ₦100 over
# ₦2,500, capped at ₦2,000 — computed on a larger base than our fee, which
# is 1.5%-of-just-the-share) and still hand the organizer their full,
# un-reduced share. A lower rate looks friendlier but silently shorts
# organizers on real payouts once Paystack's own fee is deducted.
CONVENIENCE_FEE_RATE=0.0575

# Optional — Sentry error tracking. Leave blank to disable.
SENTRY_DSN=
